{
  "compilerOptions": {
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "strict": true,
    "target": "es6",
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "types": ["node"],
    "isolatedModules": true,
    "declaration": true,
    "lib": [
      "es2016"
    ],
    "rootDir": ".",
    "sourceMap": true,
    "skipLibCheck": true,
  },
  "include": [
    "testing"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/*",
    "vscode-client/out",
    "server/out",
    "testing"
  ],
  "references": [
    { "path": "./vscode-client" },
    { "path": "./server" },
    { "path": "./tsconfig.test.json" }
  ]
}
